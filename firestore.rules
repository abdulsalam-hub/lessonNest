rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return signedIn() && request.auth.token.admin == true;
    }

    match /users/{userId} {
      allow create: if isOwner(userId)
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.role == 'teacher'
        && request.resource.data.keys().hasOnly([
          'uid', 'displayName', 'email', 'role', 'createdAt', 'updatedAt'
        ]);
      allow read: if isOwner(userId) || isAdmin();
      allow update: if isOwner(userId)
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.email == resource.data.email
        && request.resource.data.role == resource.data.role
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['displayName', 'updatedAt']);
      allow delete: if isAdmin();
    }

    match /resources/{resourceId} {
      // Full records may contain Cloudinary file URLs. Keep them admin-only.
      allow read, create, update, delete: if isAdmin();
    }

    match /publicResources/{resourceId} {
      // Public catalogue documents contain metadata only, never file URLs.
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /purchases/{purchaseId} {
      allow read: if signedIn() && resource.data.userId == request.auth.uid;
      allow write: if false;
    }

    match /payments/{paymentId} {
      allow read: if signedIn() && resource.data.userId == request.auth.uid;
      allow write: if false;
    }

    match /schools/{schoolId} {
      allow read, write: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
